{
	"name": "tictactoe-java",
	"image": "ghcr.io/flashbibi/450-tictactest-mvk:v1.0.2",
	"customizations": {
		"vscode": {
			"extensions": [
				"vscjava.vscode-java-pack",
				"vscjava.vscode-gradle"
			]
		}
	},
	"forwardPorts": [8080, 8000],
	"portsAttributes": {
		"8080": { "label": "Web-Konsole" },
		"8000": { "label": "Frontend" }
	},
	"postCreateCommand": "chmod +x ./gradlew && ./gradlew --version",
	"remoteUser": "dev"
}
